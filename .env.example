APP_ENV=local
APP_DEBUG=false
APP_NAME="NeNe Concierge"
NENE2_MACHINE_API_KEY=
NENE2_LOCAL_JWT_SECRET=
# Opt-in to the built-in development JWT secret when NENE2_LOCAL_JWT_SECRET is
# unset. local/dev only — set to 1 to boot without configuring a real secret.
# Ignored in production (which always requires NENE2_LOCAL_JWT_SECRET). If both
# this and NENE2_LOCAL_JWT_SECRET are empty in local/dev, the app fails closed.
NENE2_ALLOW_DEV_SECRET=1
PROBLEM_DETAILS_BASE_URL=https://nene-concierge.dev/problems/

# --- HTTP security (CORS / HSTS) ---
# NENE_CONCIERGE_ALLOWED_ORIGINS: comma-separated exact origins allowed to make
# cross-origin (CORS) requests to the API — e.g. the admin SPA origin and any
# page hosting the embed widget. Empty (the default) fails closed: no CORS
# headers are emitted. Wildcard '*' is rejected — list each origin explicitly.
# Production installs served from another origin MUST set this.
# Example: https://admin.example.com,https://www.customer.example
NENE_CONCIERGE_ALLOWED_ORIGINS=
# NENE_CONCIERGE_ENABLE_HSTS: emit Strict-Transport-Security. Off by default.
# Set to 1 only when served over HTTPS (directly or behind a TLS-terminating
# proxy).
NENE_CONCIERGE_ENABLE_HSTS=0

# --- Multi-tenancy ---
# TENANT_RESOLUTION: single | subdomain | path
# single  = ORG_SLUG env var (Tier A / single-org Tier B)
# subdomain = org1.example.com → slug "org1"
# path    = /org1/api/v1/... → slug "org1"
TENANT_RESOLUTION=single
ORG_SLUG=

# --- Database (MySQL only) ---
#
# 🔴 SQLite は使えません（#217・2026-08-04 実測）。Phinx の SQLite アダプタが `enum` カラムを
# 扱えないため、5 本目の migration (CreateScenariosTable) で
#   InvalidArgumentException: An invalid column type "enum" was specified for column "status".
# と落ちて、スキーマを作れません。以前ここには「host / PHPUnit default: SQLite」と書かれて
# いましたが、PHPUnit スイートは DB に接続しない（テストが PDO を一切使わない）ため、
# 使われないまま残っていた設定でした。
#
# DB が要るのは migration と E2E だけで、そのときは下記の値で MySQL コンテナへ繋ぎます。
DATABASE_URL=
DB_ENV=local
DB_ADAPTER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=nene_concierge
DB_USER=nene_concierge
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ホスト側から直接 MySQL へ繋ぐ場合（コンテナ外で phinx を回すなど）は、
# コンテナ名ではなくポートマッピング経由にする:
# DB_HOST=127.0.0.1
# DB_PORT=${NENE_CONCIERGE_MYSQL_PORT}   # 既定 3790
# DB_PASSWORD=nene_concierge
# MYSQL_ROOT_PASSWORD=nene_concierge_root
#
# NeNe Concierge 固定ポート (87xx/3790 — NeNe エコシステム内でユニーク)
# 変更する場合は docs/workflow.md のポートマップも更新すること
NENE_CONCIERGE_PORT=8790
NENE_CONCIERGE_MYSQL_PORT=3790
NENE_CONCIERGE_PHPMYADMIN_PORT=8791
